# Copy this file to .env.local and fill in the values.
# Supabase → Project Settings → API

# Public project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://lbbotfsgkqddzzshmwvw.supabase.co

# Publishable / anon key (safe to ship to the browser; RLS scopes the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth is configured in the Supabase dashboard, NOT here:
#   Authentication → Providers → Google  (paste the Google Client ID + Secret)
#   Authentication → URL Configuration   (Site URL + Redirect URLs)
# If sign-in fails with "invalid_client / client secret invalid", the Client
# Secret stored in that Google provider screen is wrong — re-paste it from the
# Google Cloud Console OAuth client (and make sure it matches the Client ID).
